{
  "name": "@deckos/server",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "pnpm --filter @deckos/contracts build && tsc",
    "typecheck": "pnpm --filter @deckos/contracts build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "import-templates": "tsx scripts/import-casaos-templates.ts"
  },
  "dependencies": {
    "@deckos/contracts": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@hono/node-server": "^2.1.0",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "busboy": "^1.6.0",
    "dockerode": "^5.0.1",
    "fs-extra": "^11.4.0",
    "hono": "^4.13.1",
    "protobufjs": "8.7.2",
    "systeminformation": "^5.33.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/dockerode": "^4.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
