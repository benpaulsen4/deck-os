    "@testing-library/user-event": "^14.6.3",
    "@types/codemirror": "^5.60.18",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
